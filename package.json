{
  "name": "code-summary-generator",
  "displayName": "Code Summary Generator",
  "publisher": "SarthakBhatnagar30",
  "description": "Generates a JSON summary of a codebase and creates README using AI.",
  "version": "0.1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/SarthakBhatnagar30/code-summary-generator.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:extension.generateCodeSummary"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.generateCodeSummary",
        "title": "Generate Code Summary with AI",
        "category": "Code Summary"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "extension.generateCodeSummary",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "configuration": {
      "title": "Code Summary Generator",
      "properties": {
        "codeSummaryGenerator.apiKey": {
          "type": "string",
          "default": "",
          "description": "Your Gemini API key for generating code summaries",
          "markdownDescription": "Enter your Gemini API key. Get one from [Google AI Studio](https://makersuite.google.com/app/apikey)"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "node ./test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "16.x",
    "@types/vscode": "^1.80.0",
    "@vscode/test-electron": "^2.1.5",
    "eslint": "^8.24.0",
    "glob": "^8.0.3",
    "mocha": "^10.0.0",
    "typescript": "^4.8.4"
  },
  "dependencies": {
    "atob": "^2.1.2"
  }
}
