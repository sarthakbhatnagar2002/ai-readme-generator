{
  "name": "code-summary-generator",
  "displayName": "Code Summary Generator",
  "publisher": "SarthakBhatnagar30",
  "description": "Generates a JSON and PDF summary of a codebase using AI.",
  "version": "0.0.9",
  "repository": {
    "type": "git",
    "url": "https://github.com/SarthakBhatnagar30/code-summary-generator.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:extension.generateCodeSummary"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.generateCodeSummary",
        "title": "Generate Code Summary",
        "category": "Code Summary"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "extension.generateCodeSummary",
          "when": "workspaceFolderCount > 0"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "node ./test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "16.x",
    "@types/vscode": "^1.80.0",
    "@vscode/test-electron": "^2.1.5",
    "eslint": "^8.24.0",
    "glob": "^8.0.3",
    "mocha": "^10.0.0",
    "typescript": "^4.8.4"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "jspdf": "^3.0.1"
  }
}
